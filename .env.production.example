# 모든 이미지 값은 배포 레지스트리의 불변 digest 참조(repository@sha256:...)를 사용하세요.
ALPHA_API_IMAGE=registry.example.com/alpha-api@sha256:replace
ALPHA_WEB_IMAGE=registry.example.com/alpha-web@sha256:replace
ALPHA_JUDGE_WORKER_IMAGE=registry.example.com/alpha-judge-worker@sha256:replace
ALPHA_WORKSPACE_WORKER_IMAGE=registry.example.com/alpha-workspace-worker@sha256:replace
JUDGE_IMAGE=registry.example.com/alpha-judge-runner@sha256:replace
WORKSPACE_IMAGE=registry.example.com/alpha-workspace-runner@sha256:replace

POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-value
DATABASE_URL=postgres://alpha:replace-with-url-encoded-password@db:5432/alpha
SESSION_SECRET=replace-with-at-least-32-random-bytes
WORKSPACE_RECEIPT_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_BASE_URL=https://alpha.example.com
ALPHA_PORT=8080
ALPHA_JUDGE_WORKSPACE=/srv/alpha/judge-work
ALPHA_WORKSPACE_ROOT=/srv/alpha/workspace

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SOLVED_AC_ENABLED=false

CONTENT_AI_ENABLED=false
# API에는 값이 아니라 worker에 실제로 주입된 변수 이름만 전달합니다.
CONTENT_AI_CREDENTIALS_AVAILABLE=
CONTENT_WORKER_ID=production-content-worker-1
CONTENT_AI_CUSTOM_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
