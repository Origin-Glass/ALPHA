# 로컬 Compose 전용 예시입니다. 운영에서는 compose.production.yaml의 필수값을 사용하세요.
POSTGRES_PASSWORD=alpha-local-only
SESSION_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_BASE_URL=http://localhost:8080
TEST_IDENTITY_ENABLED=true
ALPHA_PORT=8080
ALPHA_JUDGE_WORKSPACE=/tmp/alpha-judge-work
CONTENT_AI_ENABLED=false
CONTENT_AI_CREDENTIALS_AVAILABLE=
CONTENT_AI_CUSTOM_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
